{
  "metadata": {
    "display_name": "回复闸门",
    "short_desc": "用选择概率决定一条消息要不要触发 LLM。",
    "desc": "基于 TypeSafe Jev 的会话触发门：一次请求扇出多个 choice head，答案严格校验，被拒的消息在进入 LLM 请求之前就被拦掉，并带突发去抖。"
  },
  "config": {
    "enable": {
      "description": "启用本插件",
      "hint": "关闭后插件完全不介入消息流程。"
    },
    "language": {
      "description": "回复语言",
      "hint": "仅影响插件在本会话中的回复；auto 跟随 AstrBot 的 language 设置，未设置时用英文。",
      "labels": [
        "跟随 AstrBot",
        "English",
        "简体中文"
      ]
    },
    "api_key": {
      "description": "TypeSafe API Key",
      "hint": "在 typesafe.ai 获取。"
    },
    "model": {
      "description": "TypeSafe 模型"
    },
    "base_url": {
      "description": "TypeSafe 端点"
    },
    "timeout_sec": {
      "description": "单次请求超时（秒）"
    },
    "retries": {
      "description": "限流重试次数",
      "hint": "仅在 429/503/529 时重试，指数退避。"
    },
    "respond_threshold": {
      "description": "触发阈值 P(RESPOND)",
      "hint": "低于该值就静默。调高更保守。"
    },
    "min_confidence": {
      "description": "最低置信度",
      "hint": "模型自报置信度低于该值就静默。"
    },
    "fail_mode": {
      "description": "异常时的策略",
      "hint": "open 照常回复（不影响可用性），closed 静默。",
      "labels": [
        "open：照常回复",
        "closed：静默"
      ]
    },
    "scope_private": {
      "description": "对私聊生效"
    },
    "scope_group": {
      "description": "对群聊生效"
    },
    "bypass_command": {
      "description": "指令消息直接放行"
    },
    "bypass_mention": {
      "description": "被 @ 时直接放行"
    },
    "bypass_quote_bot": {
      "description": "引用机器人消息时直接放行"
    },
    "bypass_admin": {
      "description": "管理员直接放行"
    },
    "debounce_enable": {
      "description": "启用突发去抖"
    },
    "debounce_window_sec": {
      "description": "去抖窗口（秒）"
    },
    "debounce_max_replies": {
      "description": "窗口内最多回复次数",
      "hint": "设为 1 表示一轮刷屏只回一次。"
    },
    "reply_target": {
      "description": "预测要回复哪条消息",
      "hint": "同一个请求里多答一个 head，仅在决定回复时消费。"
    },
    "inject_hint": {
      "description": "把选中的消息提示给模型"
    },
    "history_max_messages": {
      "description": "传给决策模型的消息条数"
    },
    "log_decisions": {
      "description": "记录每次决策"
    }
  },
  "messages": {
    "status.header": "Reply Gate：{state} · {model}",
    "status.policy": "阈值 P(RESPOND) >= {threshold} · 最低置信度 {confidence} · {fail_mode}",
    "status.stats": "统计：{stats}",
    "status.stats_empty": "统计：暂无",
    "status.recent": "最近决策：",
    "status.recent_item": "  {time} p={p} -> {verdict}（{reason}）",
    "state.on": "已开启",
    "state.off": "已关闭",
    "verdict.respond": "触发",
    "verdict.silent": "静默",
    "cmd.enabled": "Reply Gate {state}。",
    "cmd.reset": "已清空去抖窗口与决策统计。",
    "prompt.header": "{endpoint} · 模型 {model} · 密钥{key_state} · 转录 {count} 条",
    "prompt.key_set": "已设置",
    "prompt.key_unset": "未设置",
    "test.usage": "用法：/replygate test <文本>",
    "test.header": "干跑 · 输入：{text} · 消息数：{count}（未写入真实转录）",
    "test.endpoint": "端点：{endpoint} · 模型 {model}",
    "test.validation_failed": "答案未通过严格校验：{error}",
    "test.call_failed": "调用失败：{error}（fail_mode={fail_mode}，实际聊天中会{effect}）",
    "test.effect_reply": "照常回复",
    "test.effect_silent": "静默",
    "test.decision": "P(RESPOND)={p} · 置信度={confidence} · target={target}",
    "test.verdict": "-> {verdict}（{reason}）",
    "test.thresholds": "阈值敏感性：{rows}",
    "test.threshold_row": ">={threshold} {verdict}",
    "test.latency": "耗时：{ms}ms",
    "test.heads": "head 概率：",
    "test.head_row": "  {head}: {values}",
    "test.debounce": "去抖：{detail}",
    "truncated": "\\n…（已截断）"
  }
}
