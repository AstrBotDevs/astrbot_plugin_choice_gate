{
  "enable": {
    "description": "启用本插件",
    "type": "bool",
    "default": true,
    "hint": "关闭后插件完全不介入消息流程。"
  },
  "api_key": {
    "description": "TypeSafe API Key",
    "type": "string",
    "default": "",
    "secret": true,
    "hint": "在 typesafe.ai 获取。",
    "obvious_hint": true
  },
  "model": {
    "description": "TypeSafe 模型",
    "type": "string",
    "default": "jev-latest"
  },
  "base_url": {
    "description": "TypeSafe 端点",
    "type": "string",
    "default": "https://api.typesafe.ai/v1/systemone"
  },
  "timeout_sec": {
    "description": "单次请求超时（秒）",
    "type": "int",
    "default": 20
  },
  "retries": {
    "description": "限流重试次数",
    "type": "int",
    "default": 1,
    "hint": "仅在 429/503/529 时重试，指数退避。"
  },
  "respond_threshold": {
    "description": "触发阈值 P(RESPOND)",
    "type": "float",
    "default": 0.5,
    "hint": "P(RESPOND) 低于该值就静默。调高更保守。"
  },
  "min_confidence": {
    "description": "最低置信度",
    "type": "float",
    "default": 0.0
  },
  "fail_mode": {
    "description": "TypeSafe 异常时的策略",
    "type": "string",
    "default": "open",
    "options": [
      "open",
      "closed"
    ],
    "hint": "open：异常时照常回复（不影响可用性）；closed：异常时静默（更省）。"
  },
  "scope_private": {
    "description": "对私聊生效",
    "type": "bool",
    "default": true
  },
  "scope_group": {
    "description": "对群聊生效",
    "type": "bool",
    "default": true
  },
  "bypass_command": {
    "description": "指令消息直接放行",
    "type": "bool",
    "default": true
  },
  "bypass_mention": {
    "description": "被 @ 时直接放行",
    "type": "bool",
    "default": true
  },
  "bypass_quote_bot": {
    "description": "引用机器人消息时直接放行",
    "type": "bool",
    "default": true
  },
  "bypass_admin": {
    "description": "管理员直接放行",
    "type": "bool",
    "default": true
  },
  "debounce_enable": {
    "description": "启用突发去抖",
    "type": "bool",
    "default": true
  },
  "debounce_window_sec": {
    "description": "去抖窗口（秒）",
    "type": "int",
    "default": 25
  },
  "debounce_max_replies": {
    "description": "窗口内最多回复次数",
    "type": "int",
    "default": 1
  },
  "reply_target": {
    "description": "预测要回复哪条消息",
    "type": "bool",
    "default": true
  },
  "inject_hint": {
    "description": "把选中的消息提示给模型",
    "type": "bool",
    "default": true
  },
  "history_max_messages": {
    "description": "传给决策模型的消息条数",
    "type": "int",
    "default": 12
  },
  "log_decisions": {
    "description": "记录每次决策",
    "type": "bool",
    "default": false
  }
}