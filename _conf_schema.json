{
  "enable": {
    "description": "Enable the plugin",
    "type": "bool",
    "default": true,
    "hint": "When off, the plugin does not touch the message flow."
  },
  "language": {
    "description": "Reply language",
    "type": "string",
    "default": "auto",
    "options": [
      "auto",
      "en-US",
      "zh-CN"
    ],
    "labels": [
      "Follow AstrBot",
      "English",
      "简体中文"
    ],
    "hint": "Applies to this plugin's chat replies. Auto follows AstrBot's language setting and falls back to English."
  },
  "api_key": {
    "description": "TypeSafe API key",
    "type": "string",
    "default": "",
    "secret": true,
    "obvious_hint": true,
    "hint": "Get one at typesafe.ai."
  },
  "model": {
    "description": "TypeSafe model",
    "type": "string",
    "default": "jev-latest"
  },
  "base_url": {
    "description": "TypeSafe endpoint",
    "type": "string",
    "default": "https://api.typesafe.ai/v1/systemone"
  },
  "timeout_sec": {
    "description": "Request timeout (seconds)",
    "type": "int",
    "default": 20
  },
  "retries": {
    "description": "Retries on rate limits",
    "type": "int",
    "default": 1,
    "hint": "Retries 429/503/529 with exponential backoff."
  },
  "respond_threshold": {
    "description": "Respond threshold",
    "type": "float",
    "default": 0.5,
    "hint": "A message stays unanswered when P(RESPOND) is below this. Raise it to be more conservative."
  },
  "min_confidence": {
    "description": "Minimum confidence",
    "type": "float",
    "default": 0.0,
    "hint": "Stay silent when the reported confidence is below this."
  },
  "fail_mode": {
    "description": "Behaviour on failure",
    "type": "string",
    "default": "open",
    "options": [
      "open",
      "closed"
    ],
    "labels": [
      "open: reply as usual",
      "closed: stay silent"
    ],
    "hint": "Applies to TypeSafe errors and answers that fail validation."
  },
  "scope_private": {
    "description": "Handle private chats",
    "type": "bool",
    "default": true
  },
  "scope_group": {
    "description": "Handle group chats",
    "type": "bool",
    "default": true
  },
  "bypass_command": {
    "description": "Let commands through",
    "type": "bool",
    "default": true
  },
  "bypass_mention": {
    "description": "Let mentions through",
    "type": "bool",
    "default": true
  },
  "bypass_quote_bot": {
    "description": "Let quotes of the bot through",
    "type": "bool",
    "default": true
  },
  "bypass_admin": {
    "description": "Let administrators through",
    "type": "bool",
    "default": true
  },
  "debounce_enable": {
    "description": "Enable burst debounce",
    "type": "bool",
    "default": true
  },
  "debounce_window_sec": {
    "description": "Debounce window (seconds)",
    "type": "int",
    "default": 25
  },
  "debounce_max_replies": {
    "description": "Replies per window",
    "type": "int",
    "default": 1,
    "hint": "1 means one reply per burst."
  },
  "reply_target": {
    "description": "Predict which message to answer",
    "type": "bool",
    "default": true,
    "hint": "Adds a second speculative head to the same request."
  },
  "inject_hint": {
    "description": "Tell the model which message was selected",
    "type": "bool",
    "default": true
  },
  "history_max_messages": {
    "description": "Messages sent to the gate",
    "type": "int",
    "default": 12
  },
  "log_decisions": {
    "description": "Log every decision",
    "type": "bool",
    "default": false
  }
}
